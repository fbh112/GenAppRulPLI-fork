  /*CA_COMMERCIAL_PTR = ADDR(CA_POLICY_SPECIFIC);*/                     09720035
    SUBSTR(CA_POLICY_RAW,1,WS_COMM_LEN) = DB2_COMM_TEXT;                09730037
