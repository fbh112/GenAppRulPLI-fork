 /*================================================================*    10660000
 * Use Select on Claim to return a                                      10670000
 * single row that matches the claim number                             10680000
 *================================================================*/    10690000
 GET_Claim_DB2_INFO_1: PROCEDURE;                                       10700000
                                                                        10710000
  EM_SQLREQ = ' SELECT Claim ';                                         10720000
                                                                        10730000
  EXEC SQL                                                              10740000
    SELECT                                                              10750000
          POLICY.CustomerNumber,                                        10760000
          ClaimNumber,                                                  10770000
          CLAIM.PolicyNumber,                                           10780000
          ClaimDate,                                                    10790000
          Paid,                                                         10800000
          Value,                                                        10810000
          Cause,                                                        10820000
          Observations                                                  10830000
    INTO  :DB2_Customernum_INT,                                         10840000
          :DB2_Claimnum_INT,                                            10850000
          :DB2_POLICYNUM_INT,                                           10860000
          :DB2_C_Date,                                                  10870000
          :DB2_C_Paid_INT,                                              10880000
          :DB2_C_Value_INT,                                             10890000
          :DB2_C_Cause,                                                 10900000
          :DB2_C_Observations                                           10910000
    FROM  POLICY,CLAIM                                                  10920000
    WHERE ( POLICY.POLICYNUMBER =                                       10930000
               CLAIM.POLICYNUMBER   AND                                 10940000
            CLAIM.ClaimNumber =                                         10950000
               :DB2_ClaimNum_INT             );                         10960000
                                                                        10970000
  IF (SQLCODE = 0) THEN DO;                                             10980000
 /*      Select was successful */                                       10990000
                                                                        11000000
 /*      Calculate size of commarea required to return all data */      11010000
    WS_REQUIRED_CA_LEN = WS_CA_HEADERTRAILER_LEN + WS_REQUIRED_CA_LEN;  11020000
    WS_REQUIRED_CA_LEN = WS_FULL_CLAIM_LEN       + WS_REQUIRED_CA_LEN;  11030000
                                                                        11040000
 /*      if commarea received is not large enough ...                   11050000
 *        set error return code and return to caller */                 11060000
    IF (EIBCALEN < WS_REQUIRED_CA_LEN) THEN DO;                         11070000
      CA_RETURN_CODE = '98';                                            11080000
      EXEC CICS RETURN;                                                 11090000
    END;                                                                11100000
    ELSE DO;                                                            11110000
      CA_CUSTOMER_NUM = DB2_Customernum_INT;                            11120000
      CA_POLICY_NUM   = DB2_PolicyNum_INT;                              11130000
      DB2_C_Num       = DB2_Claimnum_INT;                               11140000
      DB2_C_Paid      = DB2_C_Paid_INT;                                 11150000
      DB2_C_Value     = DB2_C_Value_INT;                                11160000
                                                                        11170000
    /*   CA_POLICY_COMMON = DB2_POLICY_COMMON;  */                      11180003
      CA_ISSUE_DATE    = DB2_ISSUEDATE;                                 11190003
      CA_EXPIRY_DATE   = DB2_EXPIRYDATE;                                11200003
      CA_LASTCHANGED   = DB2_LASTCHANGED;                               11210003
      CA_BROKERID      = DB2_BROKERID;                                  11220003
      CA_BROKERSREF    = DB2_BROKERSREF;                                11230003
      CA_PAYMENT       = DB2_PAYMENT;                                   11240003
    /*CA_CLAIM_PTR = ADDR(CA_POLICY_SPECIFIC);*/                        11250035
      SUBSTR(CA_POLICY_RAW,1,WS_COMM_LEN) = DB2_CLAIM_TEXT;             11260037
    END;                                                                11270000
                                                                        11280000
 /*      Mark the end of the policy data */                             11290000
    SUBSTR(CA_C_FILLER,1,5) = 'FINAL';                                  11300000
  END;                                                                  11310000
  ELSE DO;                                                              11320000
 /*      Non-zero SQLCODE from first SQL FETCH statement */             11330000
    IF (SQLCODE = 100) THEN DO;                                         11340000
 /*        No rows found - invalid customer / policy number */          11350000
      CA_RETURN_CODE = '01';                                            11360000
    END;                                                                11370000
    ELSE DO;                                                            11380000
 /*        something has gone wrong */                                  11390000
      CA_RETURN_CODE = '90';                                            11400000
 /*        Write error message to TD QUEUE(CSMT) */                     11410000
      CALL WRITE_ERROR_MESSAGE;                                         11420000
    END;                                                                11430000
  END;                                                                  11440000
                                                                        11450000
 END GET_Claim_DB2_INFO_1;                                              11460000
                                                                        11470000
