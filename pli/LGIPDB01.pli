 /*================================================================*    08790000
 * Use Cursor to obtain matching customer policy records          *     08800000
 * from commercial table                                          *     08810000
 *================================================================*/    08820000
 GET_Commercial_DB2_INFO_3: PROCEDURE;                                  08830000
                                                                        08840000
  EM_SQLREQ = ' SELECT Commrcl ';                                       08850022
  ICOM_Record_Count = 0;                                                08860000
                                                                        08870000
  EXEC SQL                                                              08880000
    OPEN Cust_Cursor;                                                   08890000
                                                                        08900000
  IF (SQLCODE <> 0) THEN DO;                                            08910000
    CA_RETURN_CODE = '89';                                              08920000
    CALL WRITE_ERROR_MESSAGE;                                           08930000
  END;                                                                  08940000
                                                                        08950000
  DO UNTIL (SQLCODE > 0);                                               08960000
     CALL GET_Commercial_DB2_INFO_3_Cur;                                08970000
  END;                                                                  08980000
                                                                        08990000
  EXEC SQL                                                              09000000
    Close Cust_Cursor;                                                  09010000
                                                                        09020000
  IF (SQLCODE <> 0) THEN DO;                                            09030000
    CA_RETURN_CODE = '88';                                              09040000
    CALL WRITE_ERROR_MESSAGE;                                           09050000
  END;                                                                  09060000
                                                                        09070000
  /* ADDR(ICOM_Record) = ICOM_Pointer_Start; */                         09080011
                                                                        09090000
  ICOM_Data_Length = ICOM_Record_Count * 1202;                          09100000
  Exec CICS Put Container('ICOM-Data')                                  09110000
                Channel('ICOM')                                         09120000
                From(ICOM_Record)                                       09130000
                Flength(ICOM_Data_Length);                              09140000
                                                                        09150000
  Exec CICS Put Container('ICOM-Count')                                 09160000
                Channel('ICOM')                                         09170000
                From(ICOM_Record_Count)                                 09180000
                Flength(2);                                             09190000
                                                                        09200000
 END GET_Commercial_DB2_INFO_3;                                         09210000
                                                                        09220000
 /*---------------------------------------------------------*/          09230000
 GET_Commercial_DB2_INFO_3_Cur: PROCEDURE;                              09240000
                                                                        09250000
  COMM_AREA_PTR = ICOM_Pointer;                                         09260000
                                                                        09270000
  EXEC SQL                                                              09280000
    Fetch Cust_Cursor                                                   09290000
    INTO                                                                09300000
          :DB2_CUSTOMERNUM_INT,                                         09310000
          :DB2_POLICYNUM_INT,                                           09320000
          :DB2_LASTCHANGED,                                             09330000
          :DB2_ISSUEDATE,                                               09340000
          :DB2_EXPIRYDATE,                                              09350000
          :DB2_B_Address,                                               09360000
          :DB2_B_Postcode,                                              09370000
          :DB2_B_Latitude,                                              09380000
          :DB2_B_Longitude,                                             09390000
          :DB2_B_Customer,                                              09400000
          :DB2_B_PropType,                                              09410000
          :DB2_B_FirePeril_INT,                                         09420000
          :DB2_B_FirePremium_INT,                                       09430000
          :DB2_B_CrimePeril_INT,                                        09440000
          :DB2_B_CrimePremium_INT,                                      09450000
          :DB2_B_FloodPeril_INT,                                        09460000
          :DB2_B_FloodPremium_INT,                                      09470000
          :DB2_B_WeatherPeril_INT,                                      09480000
          :DB2_B_WeatherPremium_INT,                                    09490000
          :DB2_B_Status_INT,                                            09500000
