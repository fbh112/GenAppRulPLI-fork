 /*===================================================================*/12130000
 /* Procedure to write error message to Queues                        */12140000
 /*   message will include Date, Time, Program Name, Customer         */12150000
 /*   Number, Policy Number and SQLCODE.                              */12160000
 /*===================================================================*/12170000
 WRITE_ERROR_MESSAGE: PROC;                                             12180000
 /* Save SQLCODE in message */                                          12190000
 EM_SQLRC = SQLCODE;                                                    12200000
 /* Obtain and format current time and date */                          12210000
 EXEC CICS ASKTIME ABSTIME(ABS_TIME);                                   12220000
 EXEC CICS FORMATTIME ABSTIME(ABS_TIME)                                 12230000
           MMDDYYYY(DATE1)                                              12240000
           TIME(TIME1);                                                 12250000
 EM_DATE = DATE1;                                                       12260000
 EM_TIME = TIME1;                                                       12270000
 /* Write output message to TDQ */                                      12280000
 EXEC CICS LINK PROGRAM('LGSTSQ')                                       12290000
           COMMAREA(ERROR_MSG)                                          12300000
           LENGTH(STG(ERROR_MSG));                                      12310000
 /* Write 90 bytes or as much as we have of commarea to TDQ */          12320000
 IF EIBCALEN > 0 THEN DO;                                               12330000
    IF EIBCALEN < 91 THEN DO;                                           12340000
       CA_DATA = LEFT(COMM_AREA_RAW,EIBCALEN);                          12350000
       EXEC CICS LINK PROGRAM('LGSTSQ')                                 12360000
                 COMMAREA(CA_ERROR_MSG)                                 12370000
                 LENGTH(STG(CA_ERROR_MSG));                             12380000
    END;                                                                12390000
    ELSE DO;                                                            12400000
       CA_DATA = LEFT(COMM_AREA_RAW,90);                                12410000
       EXEC CICS LINK PROGRAM('LGSTSQ')                                 12420000
                 COMMAREA(CA_ERROR_MSG)                                 12430000
                 LENGTH(STG(CA_ERROR_MSG));                             12440000
    END;                                                                12450000
 END;                                                                   12460000
 RETURN;                                                                12470000
 END WRITE_ERROR_MESSAGE;                                               12480000
 END LGIPDB01;                                                          12490025