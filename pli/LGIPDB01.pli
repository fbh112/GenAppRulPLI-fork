 /*********************************************************************/00010000
 /*                                                                   */00020000
 /*                    Inquire Policy                                 */00030000
 /*                                                                   */00040000
 /*   To obtain full details of an individual policy:                 */00050000
 /*     Endowment, House, Motor, Commercial                           */00060000
 /*                                                                   */00070000
 /*                                                                   */00080000
 /*********************************************************************/00090000
 /* LGIPDB01: Proc(COMM_AREA) Options(Main,Reentrant); */               00100032
 LGIPDB01: Proc(COMM_AREA_PTR) Options(Main);                           00101035
                                                                        00110000
 DCL 1 TSAREA,                                                          00120000
       3 TSAREAPOSTCODE           CHAR(8),                              00130000
       3 *                        CHAR INIT(''),                        00140000
       3 TSAREACUSTNUM            Pic '(10)9',                          00150000
       3 *                        CHAR INIT(''),                        00160000
       3 TSAREAPOLNUM             Pic '(10)9',                          00170000
       3 *                        CHAR INIT('');                        00180000
 /*-------------------------------------------------------------------*/00190000
 /* Common defintions                                                 */00200000
 /*-------------------------------------------------------------------*/00210000
 /* Run time (debug) infomation for this invocation */                  00220000
 DCL 1 WS_HEADER,                                                       00230000
       3 WS_EYECATCHER            CHAR(16) INIT('LGIPDB01-----WS'),     00240025
       3 WS_TRANSID               CHAR(4) INIT(''),                     00250000
       3 WS_TERMID                CHAR(4) INIT(''),                     00260000
       3 WS_TASKNUM               Pic '(7)9' INIT(0),                   00270000
       3 WS_FILLER                CHAR INIT(''),                        00280000
       3 WS_ADDR_DFHCOMMAREA      PTR INIT(SYSNULL()),                  00290000
       3 WS_CALEN                 FIXED BIN(15) INIT(0);                00300000
                                                                        00310000
 /* Variables for time/date processing */                               00320000
 DCL ABS_TIME                    FIXED BIN(31) INIT(0);                 00330000
 DCL TIME1                       CHAR(8)  INIT('');                     00340000
 DCL DATE1                       CHAR(10) INIT('');                     00350000
                                                                        00360000
 /* Error Message structure */                                          00370000
 DCL 1 ERROR_MSG,                                                       00380000
       3 EM_DATE                  CHAR(10) INIT(''),                    00390000
       3 *                        CHAR     INIT(''),                    00400000
       3 EM_TIME                  CHAR(8)  INIT(''),                    00410000
       3 *                        CHAR(9)  INIT(' LGIPOL01'),           00420000
       3 EM_VARIABLE UNION,                                             00430000
         5 EM_MSG_TEXT            CHAR(63),                             00440000
         5 *,                                                           00450000
          7 *                     CHAR(6)  INIT(' CNUM='),              00460000
          7 EM_CUSNUM             CHAR(10) INIT(''),                    00470000
          7 *                     CHAR(6)  INIT(' PNUM='),              00480000
          7 EM_POLNUM             CHAR(10) INIT(''),                    00490000
          7 EM_SQLREQ             CHAR(16) INIT(''),                    00500000
          7 *                     CHAR(9)  INIT(' SQLCODE='),           00510000
          7 EM_SQLRC              PIC '+(5)9';                          00520000
                                                                        00530000
 DCL 1 CA_ERROR_MSG,                                                    00540000
       3 *                        CHAR(9)  INIT('COMMAREA='),           00550000
       3 CA_DATA                  CHAR(90) INIT('');                    00560000
                                                                        00570000
 /*-------------------------------------------------------------------*/00580000
 /* Definitions required for data manipulation                        */00590000
 /*-------------------------------------------------------------------*/00600000
 DCL MINUS_ONE                    FIXED BIN(15) STATIC INIT(-1);        00610000
                                                                        00620000
 DCL 1 WS_COMMAREA_LENGTHS,                                             00630000
       3 WS_CA_HEADERTRAILER_LEN  FIXED BIN(15) INIT(33),               00640000
       3 WS_REQUIRED_CA_LEN       FIXED BIN(15) INIT(0);                00650026
 /*    3 WS_REQUIRED_CA_LEN       PIC 'S(4)9'   INIT(0); */             00651026
                                                                        00660000
 /* Position of first char in commarea after end of policy data */      00670000
 /* for use when placing end of data indicator */                       00680000
 DCL END_POLICY_POS              FIXED BIN(15) INIT(1);                 00690000
                                                                        00700000
 DCL ICOM_Record_Count           FIXED BIN(15);                         00710000
 DCL ICOM_Length                 FIXED BIN(31) INIT(32767);             00720000
 DCL ICOM_Data_Length            FIXED BIN(31);                         00730000
 DCL ICOM_Pointer                PTR;                                   00740000
 DCL ICOM_Pointer_Start          PTR;                                   00750000
 DCL ICOM_Container              CHAR(16) INIT('ICOM-Data');            00760000
 DCL ICOM_Channel                CHAR(16) INIT('ICOM');                 00770000
 DCL WS_Request_ID               CHAR(6);                               00780000
 DCL WS_Resp                     FIXED BIN(31);                         00790000
                                                                        00800000
 /*-------------------------------------------------------------------*/00810000
 /*    DB2 CONTROL                                                    */00820000
 /*-------------------------------------------------------------------*/00830000
 /*-------------------------------------------------------------------*/00840000
 /* Declare Cursors                                                   */00850000
 /*-------------------------------------------------------------------*/00860000
 EXEC SQL                                                               00870000
   DECLARE Cust_Cursor Insensitive Scroll Cursor For                    00880000
   SELECT                                                               00890000
         CustomerNumber,                                                00900000
         Policy.PolicyNumber,                                           00910000
         RequestDate,                                                   00920000
         StartDate,                                                     00930000
         RenewalDate,                                                   00940000
         Address,                                                       00950000
         Zipcode,                                                       00960000
         LatitudeN,                                                     00970000
         LongitudeW,                                                    00980000
         Customer,                                                      00990000
         PropertyType,                                                  01000000
         FirePeril,                                                     01010000
         FirePremium,                                                   01020000
         CrimePeril,                                                    01030000
         CrimePremium,                                                  01040000
         FloodPeril,                                                    01050000
         FloodPremium,                                                  01060000
         WeatherPeril,                                                  01070000
         WeatherPremium,                                                01080000
         Status,                                                        01090000
         RejectionReason                                                01100000
   FROM  POLICY,COMMERCIAL                                              01110000
   WHERE ( POLICY.POLICYNUMBER =                                        01120000
              Commercial.POLICYNUMBER AND                               01130000
           Policy.CustomerNumber =                                      01140000
              :DB2_CUSTOMERNUM_INT  );                                  01150000
 /*-------------------------------------------------------------------*/01160000
 EXEC SQL                                                               01170000
   DECLARE Zip_Cursor Insensitive Scroll Cursor For                     01180000
   SELECT                                                               01190000
         CustomerNumber,                                                01200000
         Policy.PolicyNumber,                                           01210000
         RequestDate,                                                   01220000
         StartDate,                                                     01230000
         RenewalDate,                                                   01240000
         Address,                                                       01250000
         Zipcode,                                                       01260000
         LatitudeN,                                                     01270000
         LongitudeW,                                                    01280000
         Customer,                                                      01290000
         PropertyType,                                                  01300000
         FirePeril,                                                     01310000
         FirePremium,                                                   01320000
         CrimePeril,                                                    01330000
         CrimePremium,                                                  01340000
         FloodPeril,                                                    01350000
         FloodPremium,                                                  01360000
         WeatherPeril,                                                  01370000
         WeatherPremium,                                                01380000
         Status,                                                        01390000
         RejectionReason                                                01400000
   FROM  POLICY,COMMERCIAL                                              01410000
   WHERE ( POLICY.POLICYNUMBER =                                        01420000
              Commercial.POLICYNUMBER   AND                             01430000
           Commercial.Zipcode =                                         01440000
              :CA_B_POSTCODE  );                                        01450000
 /*-------------------------------------------------------------------*/01460000
 EXEC SQL                                                               01470000
   DECLARE CusClaim_Cursor Insensitive Scroll Cursor For                01480000
   SELECT                                                               01490000
         POLICY.CustomerNumber,                                         01500000
         ClaimNumber,                                                   01510000
         CLAIM.PolicyNumber,                                            01520000
         ClaimDate,                                                     01530000
         Paid,                                                          01540000
         Value,                                                         01550000
         Cause,                                                         01560000
         Observations                                                   01570000
   FROM  POLICY,CLAIM                                                   01580000
   WHERE ( POLICY.POLICYNUMBER =                                        01590000
              CLAIM.POLICYNUMBER   AND                                  01600000
           POLICY.CustomerNumber =                                      01610000
              :DB2_CUSTOMERNUM_INT);                                    01620000
                                                                        01630000
 /* SQLCA DB2 communications area */                                    01640000
 EXEC SQL                                                               01650000
     INCLUDE SQLCA;                                                     01660000
                                                                        01670000
                                                                        01680000
 /*-------------------------------------------------------------------*/01690000
 /* Definitions required by SQL statement                             */01700000
 /*   DB2 datatypes to COBOL equivalents                              */01710000
 /*     SMALLINT    :   FIXED BIN(15)                                 */01720000
 /*     INTEGER     :   FIXED BIN(31)                                */ 01730000
 /*     DATE        :   CHAR(10)                                      */01740000
 /*     TIMESTAMP   :   CHAR(26)                                      */01750000
 /*-------------------------------------------------------------------*/01760000
 /* Host variables for input to DB2 integer types */                    01770000
 DCL 1 DB2_IN_INTEGERS,                                                 01780000
       3 DB2_CUSTOMERNUM_INT      FIXED BIN(31) INIT(0),                01790000
       3 DB2_POLICYNUM_INT        FIXED BIN(31) INIT(0),                01800000
       3 DB2_CLAIMNUM_INT         FIXED BIN(31) INIT(0);                01810000
 DCL 1 DB2_OUT_INTEGERS,                                                01820000
       3 DB2_BROKERID_INT         FIXED BIN(31) INIT(0),                01830000
       3 DB2_PAYMENT_INT          FIXED BIN(31) INIT(0),                01840000
       3 DB2_E_TERM_SINT          FIXED BIN(15) INIT(0),                01850000
       3 DB2_E_SUMASSURED_INT     FIXED BIN(31) INIT(0),                01860000
       3 DB2_E_PADDING_LEN        FIXED BIN(31) INIT(0),                01870000
       3 DB2_H_BEDROOMS_SINT      FIXED BIN(15) INIT(0),                01880000
       3 DB2_H_VALUE_INT          FIXED BIN(31) INIT(0),                01890000
       3 DB2_M_VALUE_INT          FIXED BIN(31) INIT(0),                01900000
       3 DB2_M_CC_SINT            FIXED BIN(15) INIT(0),                01910000
       3 DB2_M_PREMIUM_INT        FIXED BIN(31) INIT(0),                01920000
       3 DB2_M_ACCIDENTS_INT      FIXED BIN(31) INIT(0),                01930000
       3 DB2_B_FirePeril_Int      FIXED BIN(15) INIT(0),                01940000
       3 DB2_B_FirePremium_Int    FIXED BIN(31) INIT(0),                01950000
       3 DB2_B_CrimePeril_Int     FIXED BIN(15) INIT(0),                01960000
       3 DB2_B_CrimePremium_Int   FIXED BIN(31) INIT(0),                01970000
       3 DB2_B_FloodPeril_Int     FIXED BIN(15) INIT(0),                01980000
       3 DB2_B_FloodPremium_Int   FIXED BIN(31) INIT(0),                01990000
       3 DB2_B_WeatherPeril_Int   FIXED BIN(15) INIT(0),                02000000
       3 DB2_B_WeatherPremium_Int FIXED BIN(31) INIT(0),                02010000
       3 DB2_B_Status_Int         FIXED BIN(15) INIT(0),                02020000
       3 DB2_C_Paid_int           FIXED BIN(31) INIT(0),                02030000
       3 DB2_C_Value_int          FIXED BIN(31) INIT(0);                02040000
                                                                        02050000
 /* Policy descriptions to receive output from DB2 */                   02060000
 /* Must be an SQL INCLUDE so available to SQL pre_compiler */          02070000
 EXEC SQL                                                               02080000
   INCLUDE LGPOLICY;                                                    02090024
                                                                        02100000
 /* Indicator variables for columns which could return nulls */         02110000
 /*   if these are not specified and SQL FETCH tries to return */       02120000
 /*   null value for a listed column it will FAIL with SQLCODE=-305 */  02130000
 DCL IND_BROKERID                FIXED BIN(15);                         02140000
 DCL IND_BROKERSREF              FIXED BIN(15);                         02150000
 DCL IND_PAYMENT                 FIXED BIN(15);                         02160000
 DCL IND_E_PADDINGDATA           FIXED BIN(15);                         02170000
 DCL IND_E_PADDINGDATAL          FIXED BIN(15);                         02180000
                                                                        02190000
 /* DCL COMM_AREA_PTR     PTR; */                                       02191030
 /* DCL 1 COMM_AREA       UNION BASED(COMM_AREA_PTR), */                02192029
 EXEC SQL                                                               02200029
    INCLUDE LGCMAREA;                                                   02210029
                                                                        02220000
 DCL ICOM_Record      CHAR(1202) BASED(ICOM_Pointer_Start);             02230011
                                                                        02240000
 /*********************************************************************/02250000
 /*    P R O C E D U R E S                                            */02260000
 /*********************************************************************/02270000
 /*-------------------------------------------------------------------*/02280000
 /* Common code                                                       */02290000
 /*-------------------------------------------------------------------*/02300000
 /* set up general variable */                                          02310000
 WS_TRANSID = EIBTRNID;                                                 02320000
 WS_TERMID = EIBTRMID;                                                  02330000
 WS_TASKNUM = EIBTASKN;                                                 02340000
                                                                        02350000
                                                                        02360000
 Exec Cics Get Container(ICOM_Container)                                02370000
               Channel(ICOM_Channel)                                    02380000
               Flength(ICOM_Data_Length)                                02390000
               Set(ICOM_Pointer)                                        02400000
               Resp(WS_RESP);                                           02410000
 If WS_RESP = DFHRESP(NORMAL) then do;                                  02420000
    ICOM_Pointer_Start = ICOM_Pointer;                                  02430000
    COMM_AREA_PTR = ICOM_Pointer;                                       02440000
    WS_Request_ID = CA_Request_ID;                                      02450000
    DB2_Customernum_Int = CA_Customer_Num;                              02460000
 End;                                                                   02470000
 Else do;                                                               02480000
    /*----------------------------------------------------------------*/02490000
    /* Check commarea and obtain required details                     */02500000
    /*----------------------------------------------------------------*/02510000
    /* If NO commarea received issue an ABEND */                        02520000
       IF EIBCALEN = 0 THEN DO;                                         02530000
          EM_MSG_TEXT = ' NO COMMAREA RECEIVED';                        02540000
          CALL WRITE_ERROR_MESSAGE;                                     02550000
          EXEC CICS ABEND ABCODE('LGCA') NODUMP;                        02560000
       END;                                                             02570000
                                                                        02580000
    /* initialize commarea return code to zero */                       02590000
    CA_RETURN_CODE = '00';                                              02600000
    WS_CALEN = EIBCALEN;                                                02610000
    WS_ADDR_DFHCOMMAREA = COMM_AREA_PTR;                                02620000
                                                                        02630000
    /* Convert commarea customer & policy nums to DB2 integer format */ 02640000
    DB2_CUSTOMERNUM_INT = CA_CUSTOMER_NUM;                              02650000
    DB2_POLICYNUM_INT = CA_POLICY_NUM;                                  02660000
    /* and save in error msg field incase required */                   02670000
    EM_CUSNUM = CA_CUSTOMER_NUM;                                        02680000
    EM_POLNUM = CA_POLICY_NUM;                                          02690000
                                                                        02700000
    /*----------------------------------------------------------------*/02710000
    /* Check which policy type is being requested                     */02720000
    /* This is not actually required whilst only endowment policy     */02730000
    /* inquires are supported, but will make future expansion simpler */02740000
    /*----------------------------------------------------------------*/02750000
    /* Upper case value passed in Request Id field                    */02760000
    WS_REQUEST_ID = UPPERCASE(CA_REQUEST_ID);                           02770000
 End;                                                                   02780000
                                                                        02790000
 SELECT (WS_REQUEST_ID);                                                02800000
                                                                        02810000
    WHEN ('01IEND') DO;                                                 02820000
       CALL GET_ENDOW_DB2_INFO;                                         02830000
    END;                                                                02840000
                                                                        02850000
    WHEN ('01IHOU') DO;                                                 02860000
       CALL GET_HOUSE_DB2_INFO;                                         02870000
    END;                                                                02880000
                                                                        02890000
    WHEN ('01IMOT') DO;                                                 02900000
       CALL GET_MOTOR_DB2_INFO;                                         02910000
    END;                                                                02920000
                                                                        02930000
    WHEN ('01ICOM') DO;                                                 02940000
       CALL GET_COMMERCIAL_DB2_INFO_1;                                  02950000
    END;                                                                02960000
                                                                        02970000
    WHEN ('02ICOM') DO;                                                 02980000
       CALL GET_COMMERCIAL_DB2_INFO_2;                                  02990000
    END;                                                                03000000
                                                                        03010000
    WHEN ('03ICOM') DO;                                                 03020000
       CALL GET_COMMERCIAL_DB2_INFO_3;                                  03030000
    END;                                                                03040000
                                                                        03050000
    WHEN ('05ICOM') DO;                                                 03060000
       CALL GET_COMMERCIAL_DB2_INFO_5;                                  03070000
    END;                                                                03080000
                                                                        03090000
    WHEN ('01ICLM') DO;                                                 03100000
       DB2_CLAIMNUM_INT = CA_C_Num;                                     03110000
       CALL GET_CLAIM_DB2_INFO_1;                                       03120000
    END;                                                                03130000
                                                                        03140000
    WHEN ('02ICLM') DO;                                                 03150000
       CALL GET_CLAIM_DB2_INFO_2;                                       03160000
    END;                                                                03170000
                                                                        03180000
    OTHERWISE DO;                                                       03190000
       CA_RETURN_CODE = '99';                                           03200000
    END;                                                                03210000
 END;                                                                   03220000
                                                                        03230000
 /* End_Program: */                                                     03240000
    EXEC CICS RETURN;                                                   03250000
                                                                        03260000
 RETURN;                                                                03270000
                                                                        03280000
                                                                        03290000
 /*===================================================================*/03300000
 /* Use Select on join of Policy and Endowment tables to obtain       */03310000
 /* single row that matches customer and policy number requested.     */03320000
 /* NOTE: because we do not know length of varchar yet - we must      */03330000
 /*      put output of DB2 SELECT into working storage to avoid       */03340000
 /*      risk of overwriting CICS storage beyond commarea.            */03350000
 /*===================================================================*/03360000
 GET_ENDOW_DB2_INFO: PROCEDURE;                                         03370000
                                                                        03380000
    EM_SQLREQ = ' SELECT ENDOW ';                                       03390000
    EXEC SQL                                                            03400000
      SELECT  ISSUEDATE,                                                03410000
              EXPIRYDATE,                                               03420000
              LASTCHANGED,                                              03430000
              BROKERID,                                                 03440000
              BROKERSREFERENCE,                                         03450000
              PAYMENT,                                                  03460000
              WITHPROFITS,                                              03470000
              EQUITIES,                                                 03480000
              MANAGEDFUND,                                              03490000
              FUNDNAME,                                                 03500000
              TERM,                                                     03510000
              SUMASSURED,                                               03520000
              LIFEASSURED,                                              03530000
              PADDINGDATA,                                              03540000
              LENGTH(PADDINGDATA)                                       03550000
      INTO  :DB2_ISSUEDATE,                                             03560000
            :DB2_EXPIRYDATE,                                            03570000
            :DB2_LASTCHANGED,                                           03580000
            :DB2_BROKERID_INT INDICATOR :IND_BROKERID,                  03590000
            :DB2_BROKERSREF INDICATOR :IND_BROKERSREF,                  03600000
            :DB2_PAYMENT_INT INDICATOR :IND_PAYMENT,                    03610000
            :DB2_E_WITHPROFITS,                                         03620000
            :DB2_E_EQUITIES,                                            03630000
            :DB2_E_MANAGEDFUND,                                         03640000
            :DB2_E_FUNDNAME,                                            03650000
            :DB2_E_TERM_SINT,                                           03660000
            :DB2_E_SUMASSURED_INT,                                      03670000
            :DB2_E_LIFEASSURED,                                         03680000
            :DB2_E_PADDINGDATA INDICATOR :IND_E_PADDINGDATA,            03690000
            :DB2_E_PADDING_LEN INDICATOR :IND_E_PADDINGDATAL            03700000
      FROM  POLICY,ENDOWMENT                                            03710000
      WHERE ( POLICY.POLICYNUMBER =                                     03720000
                 ENDOWMENT.POLICYNUMBER   AND                           03730000
              POLICY.CUSTOMERNUMBER =                                   03740000
                 :DB2_CUSTOMERNUM_INT      AND                          03750000
              POLICY.POLICYNUMBER =                                     03760000
                 :DB2_POLICYNUM_INT        );                           03770000
                                                                        03780000
    SELECT (SQLCODE);                                                   03790017
    WHEN (0) DO;                                                        03800017
       /*      Select was successful */                                 03810017
       CALL GET_ENDOW_DB2_INFO_A;                                       03820019
    END; /* SQLCODE = 0 */                                              03830017
    WHEN (100) DO;                                                      03840017
      /*      Non_zero SQLCODE from first SQL FETCH statement */        03850017
      /*        No rows found - invalid customer / policy number */     03860017
         CA_RETURN_CODE = '01';                                         03870017
    END; /* SQLCODE = 100 */                                            03880017
    OTHERWISE DO;                                                       03890017
      /*        something has gone wrong */                             03900017
        CA_RETURN_CODE = '90';                                          03910017
      /*        Write error message to TD QUEUE(CSMT) */                03920017
        CALL WRITE_ERROR_MESSAGE;                                       03930017
    END; /* OTHERWISE */                                                03940017
    END; /* SELECT SQLCODE */                                           03950021
 END GET_ENDOW_DB2_INFO;                                                03960000
                                                                        03970000
 /*================================================================*/   03980019
 GET_ENDOW_DB2_INFO_A: PROCEDURE;                                       03990019
   /*      Calculate size of commarea required to return all data */    04000019
   WS_REQUIRED_CA_LEN = WS_REQUIRED_CA_LEN                              04010019
                        + WS_CA_HEADERTRAILER_LEN;                      04020019
   WS_REQUIRED_CA_LEN = WS_REQUIRED_CA_LEN + WS_FULL_ENDOW_LEN;         04030019
                                                                        04040019
   /*-------------------------------------------------------------*/    04050019
   /*  Specific code to allow for length of VACHAR data           */    04060019
   /*  check whether PADDINGDATA field is non_null                */    04070019
   /*    and calculate length of endowment policy                 */    04080019
   /*    and position of free space in commarea after policy data */    04090019
   /*-------------------------------------------------------------*/    04100019
   IF (IND_E_PADDINGDATAL <> MINUS_ONE) THEN DO;                        04110019
      WS_REQUIRED_CA_LEN = WS_REQUIRED_CA_LEN + DB2_E_PADDING_LEN;      04120019
      END_POLICY_POS = END_POLICY_POS + DB2_E_PADDING_LEN;              04130019
   END;                                                                 04140019
                                                                        04150019
  /*      if commarea received is not large enough ..;  */              04160019
  /*        set error return code and return to caller  */              04170019
   IF (EIBCALEN < WS_REQUIRED_CA_LEN) THEN DO;                          04180020
     CA_RETURN_CODE = '98';                                             04190019
     EXEC CICS RETURN;                                                  04200019
   END;                                                                 04210019
  /*        Length is sufficent so commarea = data  */                  04220019
  /*        Move Integer fields to required length numerics */          04230019
  /*        Don't move null fields */                                   04240019
   IF (IND_BROKERID <> MINUS_ONE) THEN DO;                              04250019
      DB2_BROKERID = DB2_BROKERID_INT;                                  04260019
   END;                                                                 04270019
   IF (IND_PAYMENT <> MINUS_ONE) THEN DO;                               04280019
       DB2_PAYMENT = DB2_PAYMENT_INT;                                   04290019
   END;                                                                 04300019
                                                                        04310019
   DB2_E_TERM = DB2_E_TERM_SINT;                                        04320019
   DB2_E_SUMASSURED = DB2_E_SUMASSURED_INT;                             04330019
 /*   CA_POLICY_COMMON = DB2_POLICY_COMMON;  */                         04340019
   CA_ISSUE_DATE    = DB2_ISSUEDATE;                                    04350019
   CA_EXPIRY_DATE   = DB2_EXPIRYDATE;                                   04360019
   CA_LASTCHANGED   = DB2_LASTCHANGED;                                  04370019
   CA_BROKERID      = DB2_BROKERID;                                     04380019
   CA_BROKERSREF    = DB2_BROKERSREF;                                   04390019
   CA_PAYMENT       = DB2_PAYMENT;                                      04400019
   /*CA_ENDOWMENT_PTR = ADDR(CA_POLICY_SPECIFIC);*/                     04410035
   SUBSTR(CA_POLICY_RAW,1,WS_ENDOW_LEN)                                 04420037
         = DB2_ENDOW_TEXT;                                              04430019
   IF (IND_E_PADDINGDATA <> MINUS_ONE) THEN DO;                         04440019
      SUBSTR(CA_E_PADDING_DATA,1,DB2_E_PADDING_LEN)                     04450019
            = DB2_E_PADDINGDATA;                                        04460019
   END;                                                                 04470019
                                                                        04480019
  /*      Mark the end of the policy data */                            04490019
   SUBSTR(CA_E_PADDING_DATA,END_POLICY_POS,5)                           04500019
         = 'FINAL';                                                     04510019
 END GET_ENDOW_DB2_INFO_A;                                              04520019
 /*================================================================*    04530000
 * Use Select on join of Policy and House tables to obtain        *     04540000
 * single row that matches customer and policy number requested.  *     04550000
 * NOTE: because we do not know length of varchar yet - we must   *     04560000
 *      put output of DB2 SELECT into working storage to avoid    *     04570000
 *      risk of overwriting CICS storage beyond commarea.         *     04580000
 *================================================================*/    04590000
 GET_HOUSE_DB2_INFO: PROCEDURE;                                         04600000
                                                                        04610000
  EM_SQLREQ = ' SELECT HOUSE ';                                         04620000
  EXEC SQL                                                              04630000
        SELECT  ISSUEDATE,                                              04640000
                EXPIRYDATE,                                             04650000
                LASTCHANGED,                                            04660000
                BROKERID,                                               04670000
                BROKERSREFERENCE,                                       04680000
                PAYMENT,                                                04690000
                PROPERTYTYPE,                                           04700000
                BEDROOMS,                                               04710000
                VALUE,                                                  04720000
                HOUSENAME,                                              04730000
                HOUSENUMBER,                                            04740000
                POSTCODE                                                04750000
        INTO  :DB2_ISSUEDATE,                                           04760000
              :DB2_EXPIRYDATE,                                          04770000
              :DB2_LASTCHANGED,                                         04780000
              :DB2_BROKERID_INT INDICATOR :IND_BROKERID,                04790000
              :DB2_BROKERSREF INDICATOR :IND_BROKERSREF,                04800000
              :DB2_PAYMENT_INT INDICATOR :IND_PAYMENT,                  04810000
              :DB2_H_PROPERTYTYPE,                                      04820000
              :DB2_H_BEDROOMS_SINT,                                     04830000
              :DB2_H_VALUE_INT,                                         04840000
              :DB2_H_HOUSENAME,                                         04850000
              :DB2_H_HOUSENUMBER,                                       04860000
              :DB2_H_POSTCODE                                           04870000
        FROM  POLICY,HOUSE                                              04880000
        WHERE ( POLICY.POLICYNUMBER =                                   04890000
                   HOUSE.POLICYNUMBER    AND                            04900000
                POLICY.CUSTOMERNUMBER =                                 04910000
                   :DB2_CUSTOMERNUM_INT  AND                            04920000
                POLICY.POLICYNUMBER =                                   04930000
                   :DB2_POLICYNUM_INT               );                  04940000
                                                                        04950000
  IF (SQLCODE = 0) THEN DO;                                             04960000
 /*      Select was successful */                                       04970000
 /*      Calculate size of commarea required to return all data */      04980000
    WS_REQUIRED_CA_LEN = WS_CA_HEADERTRAILER_LEN + WS_REQUIRED_CA_LEN;  04990000
    WS_REQUIRED_CA_LEN = WS_FULL_HOUSE_LEN + WS_REQUIRED_CA_LEN;        05000000
                                                                        05010000
 /*      if commarea received is not large enough ... */                05020000
 /*        set error return code and return to caller */                05030000
    IF (EIBCALEN < WS_REQUIRED_CA_LEN) THEN DO;                         05040000
      CA_RETURN_CODE = '98';                                            05050000
      EXEC CICS RETURN;                                                 05060000
    END;                                                                05070000
    ELSE DO;                                                            05080000
 /*    Length is sufficent so move data to commarea */                  05090000
 /*    Move Integer fields to required length numerics */               05100000
 /*   Don't move null fields */                                         05110000
      IF (IND_BROKERID <> MINUS_ONE) THEN DO;                           05120000
        DB2_BROKERID = DB2_BROKERID_INT;                                05130000
      END;                                                              05140000
      IF (IND_PAYMENT <> MINUS_ONE) THEN DO;                            05150000
        DB2_PAYMENT = DB2_PAYMENT_INT;                                  05160000
      END;                                                              05170000
      DB2_H_BEDROOMS = DB2_H_BEDROOMS_SINT;                             05180000
      DB2_H_VALUE = DB2_H_VALUE_INT;                                    05190000
    /*   CA_POLICY_COMMON = DB2_POLICY_COMMON;  */                      05200003
      CA_ISSUE_DATE    = DB2_ISSUEDATE;                                 05210003
      CA_EXPIRY_DATE   = DB2_EXPIRYDATE;                                05220003
