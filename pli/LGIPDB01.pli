      CA_BROKERID      = DB2_BROKERID;                                  05240003
      CA_BROKERSREF    = DB2_BROKERSREF;                                05250003
      CA_PAYMENT       = DB2_PAYMENT;                                   05260003
    /*CA_HOUSE_PTR = ADDR(CA_POLICY_SPECIFIC);*/                        05270035
      SUBSTR(CA_POLICY_RAW,1,WS_HOUSE_LEN) = DB2_HOUSE_TEXT;            05280037
    END;                                                                05290000
                                                                        05300000
 /*  Mark the end of the policy data */                                 05310000
    SUBSTR(CA_H_FILLER,1,5) = 'FINAL';                                  05320000
  END;                                                                  05330000
  ELSE DO;                                                              05340000
 /*      Non-zero SQLCODE from first SQL FETCH statement */             05350000
    IF (SQLCODE = 100) THEN DO;                                         05360000
