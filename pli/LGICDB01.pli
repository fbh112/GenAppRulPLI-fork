  /*****************************************************************
  *                                                                *
  * LICENSED MATERIALS - PROPERTY OF IBM                           *
  *                                                                *
  * "RESTRICTED MATERIALS OF IBM"                                  *
  *                                                                *
  * CB12                                                           *
  *                                                                *
  * (C) COPYRIGHT IBM CORP. 2011, 2013 ALL RIGHTS RESERVED         *
  *                                                                *
  * US GOVERNMENT USERS RESTRICTED RIGHTS - USE, DUPLICATION,      *
  * OR DISCLOSURE RESTRICTED BY GSA ADP SCHEDULE                   *
  * CONTRACT WITH IBM CORPORATION                                  *
  *                                                                *
  *                    Inquire Customer                            *
  *                                                                *
  * Select customer details from DB2 table                         *
  *                                                                *
  ******************************************************************/
  LGICDB01: Proc(COMM_AREA_PTR) Options(Main);
  /*----------------------------------------------------------------*
  * Common defintions                                              *
  *----------------------------------------------------------------*/
  /* Run time (debug) infomation for this invocation */
   DCL 1  WS_HEADER,
        3 WS_EYECATCHER            CHAR(16)
                                   INIT ('LGICDB01------WS'),
        3 WS_TRANSID               CHAR(4) INIT(''),
        3 WS_TERMID                CHAR(4) INIT(''),
        3 WS_TASKNUM               PIC '(7)9' INIT(0),
        3 WS_FILLER                CHAR INIT(''),
        3 WS_ADDR_DFHCOMMAREA      PTR INIT(SYSNULL()),
        3 WS_CALEN                 FIXED BIN(15) INIT(0);

  /* Variables for time/date processing */
   DCL 1  WS_ABSTIME               FIXED DEC(15) INIT(+0);
   DCL 1  WS_TIME                  CHAR(8)  INIT(' ');
   DCL 1  WS_DATE                  CHAR(10) INIT(' ');

  /* Error Message structure - eye-catcher corrected to LGICDB01 */
   DCL 1  ERROR_MSG,
        3 EM_DATE                  CHAR(10) INIT(' '),
        3 *                        CHAR     INIT(' '),
        3 EM_TIME                  CHAR(8)  INIT(' '),
        3 *                        CHAR(9)  INIT(' LGICDB01'),
        3 EM_VARIABLE UNION,
          5 EM_MSG_TEXT            CHAR(63),
          5 *,
           7 *                     CHAR(6)  INIT(' CNUM='),
           7 EM_CUSNUM             CHAR(10) INIT(' '),
           7 *                     CHAR(6)  INIT(' PNUM='),
           7 EM_POLNUM             CHAR(10) INIT(' '),
           7 EM_SQLREQ             CHAR(16) INIT(' '),
           7 *                     CHAR(9)  INIT(' SQLCODE='),
           7 EM_SQLRC              PIC '+(5)9';

   DCL 1  CA_ERROR_MSG,
        3 *                        CHAR(9)  INIT('COMMAREA='),
        3 CA_DATA                  CHAR(90) INIT(' ');

  /*----------------------------------------------------------------*
  * Definitions required for data manipulation                     *
  *----------------------------------------------------------------*/
  /* Fields to check minimum commarea length */
   DCL 1 WS_COMMAREA_LENGTHS,
         03 WS_CA_HEADERTRAILER_LEN  FIXED BIN(15) INIT(18),
         03 WS_CUSTOMER_LEN          FIXED BIN(15) INIT(72),
         03 WS_REQUIRED_CA_LEN       FIXED BIN(15) INIT(0);

  /* Host variables for input to DB2 integer types */
   DCL 1 DB2_IN_INTEGERS,
         03 DB2_CUSTOMERNUMBER_INT  FIXED BIN(31) INIT(0);

  /*----------------------------------------------------------------*
  *    DB2 CONTROL                                                  *
  *----------------------------------------------------------------*/
  /* SQLCA DB2 communications area */
       EXEC SQL
         INCLUDE SQLCA;

       EXEC SQL
         INCLUDE LGCMAREA;

  /*----------------------------------------------------------------*
  * Common code                                                    *
  *----------------------------------------------------------------*/
  /* set up general variable */
   WS_TRANSID = EIBTRNID;
   WS_TERMID  = EIBTRMID;
   WS_TASKNUM = EIBTASKN;

  /* initialize DB2 host variables */
   DB2_IN_INTEGERS = 0;

  /*----------------------------------------------------------------*
  * Check commarea and obtain required details                     *
  *----------------------------------------------------------------*/
  /* If NO commarea received issue an ABEND */
   IF ( EIBCALEN = 0 ) THEN DO;
       EM_MSG_TEXT = ' NO COMMAREA RECEIVED';
       CALL WRITE_ERROR_MESSAGE;
       EXEC CICS ABEND ABCODE('LGCA') NODUMP;
    END;

  /* initialize commarea return code to zero */
   CA_RETURN_CODE = '00';
   WS_CALEN       = EIBCALEN;
   WS_ADDR_DFHCOMMAREA = COMM_AREA_PTR;

  /*----------------------------------------------------------------*
  * Process incoming commarea                                      *
  *----------------------------------------------------------------*/
  /* check commarea length meets minimum requirement */
   WS_REQUIRED_CA_LEN = WS_CA_HEADERTRAILER_LEN + WS_CUSTOMER_LEN;
   IF (EIBCALEN < WS_REQUIRED_CA_LEN) THEN DO;
     CA_RETURN_CODE = '98';
     EXEC CICS RETURN;
   END;

  /* Convert commarea customer number to DB2 integer format */
   DB2_CUSTOMERNUMBER_INT = CA_CUSTOMER_NUM;
  /* and save in error msg field in case required */
   EM_CUSNUM = CA_CUSTOMER_NUM;

  /*----------------------------------------------------------------*
  * Obtain details from DB2                                        *
  *----------------------------------------------------------------*/
   CALL GET_CUSTOMER_INFO;

  /*----------------------------------------------------------------*
  * END PROGRAM and return to caller                               *
  *----------------------------------------------------------------*/
   EXEC CICS RETURN;

  RETURN;

  /*================================================================*
  * Select customer row from DB2                                   *
  *================================================================*/
  GET_CUSTOMER_INFO: PROCEDURE;

   EM_SQLREQ = ' SELECT CUSTOMER';
   EXEC SQL
       SELECT FIRSTNAME,
              LASTNAME,
              DATEOFBIRTH,
              HOUSENAME,
              HOUSENUMBER,
              POSTCODE,
              PHONEMOBILE,
              PHONEHOME,
              EMAILADDRESS
       INTO  :CA_FIRST_NAME,
             :CA_LAST_NAME,
             :CA_DOB,
             :CA_HOUSE_NAME,
             :CA_HOUSE_NUM,
             :CA_POSTCODE,
             :CA_PHONE_MOBILE,
             :CA_PHONE_HOME,
             :CA_EMAIL_ADDRESS
       FROM CUSTOMER
       WHERE CUSTOMERNUMBER = :DB2_CUSTOMERNUMBER_INT;

   SELECT (SQLCODE);
     WHEN (0)
         CA_RETURN_CODE = '00';
     WHEN (100, -913)
         CA_RETURN_CODE = '01';
     OTHERWISE DO;
         CA_RETURN_CODE = '90';
         CALL WRITE_ERROR_MESSAGE;
         EXEC CICS RETURN;
     END;
   END;

  END GET_CUSTOMER_INFO;

  /*================================================================*
  * Procedure to write error message to Queues                     *
  *   message will include Date, Time, Program Name, Customer      *
  *   Number, Policy Number and SQLCODE.                           *
  *================================================================*/
  WRITE_ERROR_MESSAGE: PROCEDURE;
  /* Save SQLCODE in message */
   EM_SQLRC = SQLCODE;
  /* Obtain and format current time and date */
   EXEC CICS ASKTIME ABSTIME(WS_ABSTIME);

   EXEC CICS FORMATTIME ABSTIME(WS_ABSTIME)
             MMDDYYYY(WS_DATE)
             TIME(WS_TIME);

   EM_DATE = WS_DATE;
   EM_TIME = WS_TIME;
  /* Write output message to TDQ */
   EXEC CICS LINK PROGRAM('LGSTSQ')
             COMMAREA(ERROR_MSG)
             LENGTH(STG(ERROR_MSG));

  /* Write 90 bytes or as much as we have of commarea to TDQ */
   IF ( EIBCALEN > 0 ) THEN DO;
     IF ( EIBCALEN < 91 ) THEN DO;
       CA_DATA = LEFT(COMM_AREA_RAW,EIBCALEN);
       EXEC CICS LINK PROGRAM('LGSTSQ')
                 COMMAREA(CA_ERROR_MSG)
                 LENGTH(STG(CA_ERROR_MSG));
     END;
     ELSE DO;
       CA_DATA = LEFT(COMM_AREA_RAW,90);
       EXEC CICS LINK PROGRAM('LGSTSQ')
                 COMMAREA(CA_ERROR_MSG)
                 LENGTH(STG(CA_ERROR_MSG));
     END;
   END;
  RETURN;
  END WRITE_ERROR_MESSAGE;

  END LGICDB01;
